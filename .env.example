# Copy this file to .env and fill in your keys. Never commit .env.

# --- Market data (required) ---------------------------------------------
# Alpaca: free account at https://alpaca.markets -> Paper Trading dashboard
# -> "API Keys" -> Generate. Both values are shown once; copy them here.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# "iex" is the free real-time feed (IEX exchange only, so volume is a
# fraction of the whole market). "sip" is all US exchanges and needs
# Alpaca's paid "Algo Trader Plus" market data plan.
ALPACA_FEED=iex

# --- Float (optional but recommended) -----------------------------------
# Financial Modeling Prep: free key at https://site.financialmodelingprep.com/developer/docs
# Without it the float pillar shows "unknown" and never counts as passed.
FMP_API_KEY=

# --- Scanner settings (defaults shown) ----------------------------------
PORT=3000
SCAN_INTERVAL_SECONDS=15
# A quote whose last trade is older than this is treated as stale, not live.
STALE_AFTER_SECONDS=120
# Extra symbols to always check, comma separated (e.g. a morning watchlist).
WATCHLIST=

MIN_PRICE=1
MAX_PRICE=20
MIN_CHANGE_PCT=10
MIN_RVOL=5
MAX_FLOAT=20000000
PREFERRED_FLOAT=10000000
NEWS_LOOKBACK_HOURS=24
